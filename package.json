{
  "name": "mini-feed",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "碎语 Chatter —— Hono + Vue 3 + Pinia 实现的全栈信息流",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:server\" \"npm:web\"",
    "web": "vite",
    "server": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
